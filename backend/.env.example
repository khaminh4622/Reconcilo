# Agent 3 calls this OpenAI-compatible API for every uploaded-PDF analysis.
# Leave these blank only when you intentionally want the API to return an
# explicit unavailable result; there is no local AI-analysis fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# json_schema is preferred. Use json_object only with a compatible provider
# that does not implement Structured Outputs; Pydantic validation still runs.
LLM_RESPONSE_FORMAT=json_schema
# Seconds to wait for the provider before reporting it unavailable.
LLM_TIMEOUT_SECONDS=60

# Local operational limits and storage
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=1000000
AGENT3_DB_PATH=data/agent3.db

# This points only at the generated fictional demo corpus.
SYNTHETIC_DATA_DIR=synthetic_data
