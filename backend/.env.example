# ---------------------------------------------------------------------------
# Agent 3 LLM configuration
# ---------------------------------------------------------------------------
# Agent 3 calls one OpenAI-compatible endpoint for every uploaded-PDF analysis.
# Copy this file to .env and fill in ONE of the provider blocks below.
#
#   PowerShell:  Copy-Item .env.example .env
#   then:        notepad .env
#
# The real .env is gitignored and must NEVER be committed.
# Without a key the API still runs, but returns analysis_source "unavailable"
# with an explicit explanation - it never invents a result.

# === Option A: xAI Grok =====================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.20-0309-non-reasoning
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=180

# === Option B: OpenAI =======================================================
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_RESPONSE_FORMAT=json_schema
# LLM_TIMEOUT_SECONDS=60

# === Option C: Local Ollama (no key, no cost, slower) =======================
# Install from https://ollama.com then:  ollama pull qwen3:4b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Operational limits and storage
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=1000000
AGENT3_DB_PATH=data/agent3.db
SYNTHETIC_DATA_DIR=synthetic_data

# Development seeds (set to 0 to disable)
AGENT3_SEED_CUSTOMERS=1
AGENT3_SEED_BANK=1
